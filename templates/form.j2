{% extends "bootstrap/form.j2" %}

{% block head %}
{{ super() }}
{% endblock %}

{% block style %}
{{ super() }}
{% endblock %}

{% block body %}
<div class="row justify-content-center" style="width:100%; font-family: 'Open Sans';">
    <div class="container col-8">
        <div class="mb-5 mt-2 mx-0 row align-items-center">
            <div class="col-3">
            <a href="/">
                <img src="{{ url_for('static', filename='sc2targets.png') }}" style="width:175px"
                    class="img-fluid float-right">
            </a>
            </div>
            <div class="col-7 text-center">
                 <h1 style="font-weight: 50; font-size: 75px">sc2DAT</h1>
                <h3 style="font-weight: 100"> scRNA-seq 2 Drugs and Targets </h3>
                <p class="my-0">Upload a single-cell or bulk RNA-seq expression matrix and select an appropriate single-cell reference to automatically identify cell types, discover cell-surface targets, and find LINCS L1000 compounds specific to those cell types.</p>
            </div>
            <div class="col-1 ml-5 text-center">
                Executed Reports: <p style="font-weight: 1200; font-size: 1.5rem" id="numruns"></p>
            </div>
        </div>
    </div>
</div>

<div class="text-center justify-content-center mx-auto">
    <div class="row">
        <div class="col-12">
            <div id="selector" class="row mx-auto justify-content-center gap-5 mb-0">
                <div id="scRNA-seq-button" class="col-3 justify-content-center question">
                    Start with scRNA-seq data
                </div>
                <div id="bulk-RNAseq-button" class="col-3 justify-content-center question">
                    Start with Bulk Data
                </div>
            </div>

            <div class="container col-10 mt-3" style="font-size: 14px !important;">
            <div id="ga" class="mb-4"><img src="static/sc2DAT_GA.png" width="850px"/></></div>
                
                <form method="POST" enctype="multipart/form-data" action="" onsubmit="return onSubmit(event)">
                    <div hidden> 
                        {{ _fields[1].render() }}
                    </div>
                    <div id="bulk-RNA-seq" style="display: none;">
                        <div class="row mx-auto justify-content-center gap-5 mb-3">
                            <div class="btn rounded col-3 justify-content-center" style="border: solid 2px rgb(103, 103, 103); font-weight: 500; background-color: rgb(188, 234, 207);" 
                                onclick="loadBulkExample()">Load bulk RNA-seq Example 1 (Lung Cancer)</div>
                            <div class="btn rounded col-3 justify-content-center" style="border: solid 2px rgb(103, 103, 103); font-weight: 500; background-color: rgb(188, 234, 207);" 
                                onclick="loadPDACExample()">Load bulk RNA-seq Example 2 (Pancreatic Cancer)</div>
                        </div>
                        <div class="row justify-content-evenly ">
                        {% for _field in _fields[4:6] %}
                            <div class="col-6 ">
                                {{ _field.render() }}
                            </div>
                        {% endfor %}
                        </div>
                        <div class="row justify-content-evenly">
                        {% for _field in _fields[6:8] %}
                            <div class="col-4">
                                {{ _field.render() }}
                            </div>
                        {% endfor %}
                        </div>
                         <div class="row justify-content-evenly">
                         {{ _fields[8].render() }}
                         </div>

                        
                    </div>
                    <div id="scRNA-seq" style="display: none;">
                        <div class="row mx-auto justify-content-center gap-5 mb-3">
                            <div class="btn rounded col-3 justify-content-center" style="border: solid 2px rgb(103, 103, 103); font-weight: 500; background-color: rgb(188, 234, 207);" 
                                onclick="loadSCExample()">Load scRNA-seq Example 1 (Kidney IRI GSE171417)</div>
                           
                            <div class="btn rounded col-3 justify-content-center" style="border: solid 2px rgb(103, 103, 103); font-weight: 500; background-color: rgb(188, 234, 207);" 
                                onclick="loadGDCExample()">Load scRNA-seq Example 2 (GDC CPTAC-3 85cb..02fd)</div>
                            
                            <div class="btn rounded col-3 justify-content-center" style="border: solid 2px rgb(103, 103, 103); font-weight: 500; background-color: rgb(188, 234, 207);" 
                                onclick="loadCDExample()">Load scRNA-seq Example 3 (Crohn's Disease)</div>
                            
                        </div>
                        <div class="row justify-content-evenly">
                            <style>
                            .tab-pane:first-of-type {
                                --bs-gutter-x: 1.5rem;
                                --bs-gutter-y: 0;
                                display: flex;
                                flex-wrap: wrap;
                                margin-top: calc(-1 * var(--bs-gutter-y));
                                margin-right: calc(-.5 * var(--bs-gutter-x));
                                margin-left: calc(-.5 * var(--bs-gutter-x));
                                justify-content: center;
                            }
                            .tab-pane:first-of-type > div:has(> #sc_rna_file_1) {
                                flex: 0 0 auto;
                                width: 50% !important;
                            }
                            .tab-pane:first-of-type > div:has(> #sc_meta_file_1) {
                                flex: 0 0 auto;
                                width: 50% !important;
                            }
                            .tab-pane:first-of-type > div {
                                flex: 0 0 auto;
                                width: 75%;
                            }
                            </style>
                            {{ _fields[2].render() }}
                        </div>
                        <div class="row justify-content-evenly">
                            <style>
                            .tab-pane:first-of-type {
                                --bs-gutter-x: 1.5rem;
                                --bs-gutter-y: 0;
                                display: flex;
                                flex-wrap: wrap;
                                margin-top: calc(-1 * var(--bs-gutter-y));
                                margin-right: calc(-.5 * var(--bs-gutter-x));
                                margin-left: calc(-.5 * var(--bs-gutter-x));
                                justify-content: center;
                            }
                            .tab-pane:first-of-type > div:has(> #sc_rna_file_2) {
                                flex: 0 0 auto;
                                width: 50% !important;
                            }
                            .tab-pane:first-of-type > div:has(> #sc_meta_file_2) {
                                flex: 0 0 auto;
                                width: 50% !important;
                            }
                            .tab-pane:first-of-type > div {
                                flex: 0 0 auto;
                                width: 75%;
                            }
                            </style>
                            {{ _fields[3].render() }}
                        </div>
                    </div>
                    <div id="shared-area" class="row justify-content-evenly" style="display: none;">
                        {% for _field in _fields[9:-1] %}
                            <div class="col-4">
                                {{ _field.render() }}
                            </div>
                        {% endfor %}
                        <div class="col-9">
                                {{ _fields[-1].render() }}
                        </div>
                    </div>
                     
                    <div id="submit-area" class="row" style="display: none;">
                        <div class="col-sm-12">
                            <input type="submit" value="Submit" />
                            <div id="submit-feedback" class="p-2 px-5 rounded mx-auto"
                                style="position: absolute; background-color: rgba(255, 0, 0, 0.552);">
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}


{% block script %}
{{ super() }}

<script>

    document.getElementById('scRNA-seq-button').addEventListener('click', () => {
        $('#ga').fadeOut(50)
        $('#bulk-RNA-seq').fadeOut(50)
        $('#scRNA-seq').fadeIn(50)
        $('#shared-area').fadeIn()
        $('#submit-area').fadeIn(1000)
        document.forms[0].elements['data_type'].value = 'scRNA-seq';
        $('#scRNA-seq-button').addClass('selected')
        $('#bulk-RNAseq-button').removeClass('selected')

    })

    document.getElementById('bulk-RNAseq-button').addEventListener('click', () => {
        $('#ga').fadeOut(50)
        $('#scRNA-seq').fadeOut(50)
        $('#bulk-RNA-seq').fadeIn(1000)
        $('#shared-area').fadeIn()
        $('#submit-area').fadeIn(1000)
        document.forms[0].elements['data_type'].value = 'bulk RNA-seq';
        $('#scRNA-seq-button').removeClass('selected')
        $('#bulk-RNAseq-button').addClass('selected')
    })

    function loadBulkExample() {
        const textbtn = document.getElementsByClassName('text-btn ' + 'CPTAC');
        for (let i = 0; i < textbtn.length; i++) {
            textbtn[i].click();
        }
        document.forms[0].elements['condition_col'].value = 'condition'
        document.forms[0].elements['ctrl_condition'].value = 'normal'
        document.forms[0].elements['reference'].value = 'Lung Cancer Atlas (LuCA) - Salcher et al. 2022 (Human)'
        document.forms[0].elements['species'].value = 'human'
        document.forms[0].elements['tumor_validate'].value = 'Non-Small Cell Lung Cancer'
    }

    function loadPDACExample() {
        const textbtn = document.getElementsByClassName('text-btn ' + 'PDAC');
        for (let i = 0; i < textbtn.length; i++) {
            textbtn[i].click();
        }
        document.forms[0].elements['condition_col'].value = 'condition'
        document.forms[0].elements['ctrl_condition'].value = 'Normal'
        document.forms[0].elements['reference'].value = 'Pancreas - Tabula Sapiens (Human)'
        document.forms[0].elements['species'].value = 'human'
        document.forms[0].elements['tumor_validate'].value = 'Pancreatic Adenocarcinoma'
        
    }

    function loadSCExample() {
        const tabs = document.querySelectorAll('button[role="tab"]');
        for (const tab of tabs) {
            if (tab.textContent.trim() === 'Plain Text') {
                tab.click();
                break;
            }
        }
        setTimeout(() => {
            const textbtn = document.getElementsByClassName('text-btn ' + 'GSE171417');
                for (let i = 0; i < textbtn.length; i++) {
                    if (i == 0 || i == 1) textbtn[i].click();
                }
        }, 200)

        setTimeout(() => {
            document.forms[0].elements['species'].value = 'mouse'
            document.forms[0].elements['n_neighbors'].value = 15
            document.forms[0].elements['min_dist'].value = 0.01
            document.forms[0].elements['resolution'].value = 1
            document.forms[0].elements['impute'].value = False
            document.forms[0].elements['tumor_validate'].value = ''
        }, 200)

    }

    function loadGDCExample() {
        const tabs = document.querySelectorAll('button[role="tab"]');
        for (const tab of tabs) {
            if (tab.textContent.trim() === '.mtx') {
                tab.click();
                break;
            }
        }
        setTimeout(() => {
            const textbtn = document.getElementsByClassName('text-btn ' + 'GDC');
            for (let i = 0; i < textbtn.length; i++) {
                textbtn[i].click();
            }
        }, 200)

        setTimeout(() => {
            document.forms[0].elements['cell_type_col_1'].value = ''
            document.forms[0].elements['species'].value = 'human'
            document.forms[0].elements['n_neighbors'].value = 30
            document.forms[0].elements['min_dist'].value = 0.1
            document.forms[0].elements['resolution'].value = 1
            document.forms[0].elements['impute'].value = 'False'
            document.forms[0].elements['tumor_validate'].value = ''
        }, 200)
        
    }

    function loadCDExample() {
        const tabs = document.querySelectorAll('button[role="tab"]');
        for (const tab of tabs) {
            if (tab.textContent.trim() === '.mtx') {
                tab.click();
                break;
            }
        }
        setTimeout(() => {
            const textbtn = document.getElementsByClassName('text-btn ' + 'CD');
            for (let i = 0; i < textbtn.length; i++) {
                textbtn[i].click();
            }
            console.log(document.forms[0].elements)
            
        }, 200)
        setTimeout(() => {
            document.forms[0].elements['cell_type_col_1'].value = 'Celltype'
            document.forms[0].elements['species'].value = 'human'
            document.forms[0].elements['tumor_validate'].value = 'Colorectal Adenocarcinoma'
            document.forms[0].elements['n_neighbors'].value = 15
            document.forms[0].elements['min_dist'].value = 0.01
            document.forms[0].elements['resolution'].value = 1
            document.forms[0].elements['impute'].value = 'False'
 
        }, 200)
        
    }

    async function validate(formData) {
    console.warn(Object.fromEntries(formData.entries()))
    if (formData.get('data_type') == 'scRNA-seq') {
        if (formData.get('sc_data_type_1') === 'Plain Text') {
            if (!formData.get('sc_rna_file_1')) throw new Error('Please provide Data Set 1')
            if (!formData.get('sc_meta_file_1')) throw new Error('Please provide Data Set 1 Metadata')
            if ((formData.get('sc_rna_file_1').includes('GSE171417_rbk_experimental.tsv.gz')) && !(formData.get('sc_meta_file_1').includes('GSE171417_metadata_experimental.tsv'))) {
                throw new Error("If using example files, please ensure all files are from the same example.")
            }
        } else if (formData.get('sc_data_type_1') === '.mtx') {
            if (!formData.get('barcode_sc_1')) throw new Error('Please provide Data Set 1 Barcode File')
            if (!formData.get('features_sc_1')) throw new Error('Please provide Data Set 1 Features File')
            if (!formData.get('matrix_sc_1')) throw new Error('Please provide Data Set 1 Matrix File')
            if ((formData.get('matrix_sc_1').includes('Melanoma_matrix.mtx.gz')) && (!formData.get('barcode_sc_1').includes('Melanoma_barcodes.tsv.gz') || !formData.get('features_sc_1').includes('Melanoma_features.tsv.gz') || formData.get('mtx_meta_file_1'))) {
                throw new Error("If using example files, please ensure all files are from the same example.")
            }
            else if (formData.get('matrix_sc_1').includes('CD_Broad_matrix.mtx.gz') && (!(formData.get('barcode_sc_1').includes('CD_Broad_barcodes.tsv') || !formData.get('features_sc_1').includes('CD_Broad_features.tsv')))) {
                throw new Error("If using example files, please ensure all files are from the same example.")
            }
            else if (formData.get('matrix_sc_1').includes('GDC_CPTAC_3_matrix.mtx.gz') && (!(formData.get('barcode_sc_1').includes('GDC_CPTAC_3_barcodes.tsv') || !formData.get('features_sc_1').includes('GDC_CPTAC_3_features.tsv')))) {
                throw new Error("If using example files, please ensure all files are from the same example.")
            }
        } else if (formData.get('sc_data_type_1') === 'anndata') {
            if (!formData.get('anndata_sc_1')) throw new Error('Please provide Data Set 1 AnnData File')
        }
        if (formData.get('sc_data_type_2') === 'Plain Text' && (formData.get('sc_rna_file_2') || formData.get('sc_meta_file_2'))) {
            if (!formData.get('sc_rna_file_2')) throw new Error('Please provide Data Set 2 Data')
            if (!formData.get('sc_meta_file_2')) throw new Error('Please provide Data Set 2 Metadata')
            if (formData.get('sc_rna_file_1') === formData.get('sc_rna_file_2')) throw new Error('Data Set 1 & 2 Data are the same!')
            if (formData.get('sc_meta_file_1') === formData.get('sc_meta_file_2')) throw new Error('Data Set 1 & 2 Metadata are the same!')
        } else if (formData.get('sc_data_type_2') === '.mtx' && (formData.get('barcode_sc_2') || formData.get('features_sc_2') || formData.get('matrix_sc_2'))) {
            if (!formData.get('barcode_sc_2')) throw new Error('Please provide Data Set 1 Barcode File')
            if (!formData.get('features_sc_2')) throw new Error('Please provide Data Set 1 Features File')
            if (!formData.get('matrix_sc_2')) throw new Error('Please provide Data Set 1 Matrix File')
            if (formData.get('matrix_sc_1') === formData.get('matrix_sc_2')) throw new Error('Data Set 1 & 2 Data are the same!')
        } else if (formData.get('sc_data_type_2') === 'anndata') {
            if (!formData.get('anndata_sc_2')) throw new Error('Please provide Data Set 1 AnnData File')
            if (formData.get('anndata_sc_1') === formData.get('anndata_sc_2')) throw new Error('Data Set 1 & 2 Data are the same!')
        }
    } else if (formData.get('data_type') == 'bulk RNA-seq') {
        if (!formData.get('bulk_expr')) throw new Error('Please provide Bulk RNA-seq Expression Data')
        if (formData.get('bulk_expr').includes('CPTAC_LUAD_counts.tsv') && !(formData.get('bulk_meta').includes('CPTAC_LUAD_meta.tsv')) && (formData.get('bulk_meta') != '')) {
                throw new Error("If using example files, please ensure all files are from the same example.")
        }
        if (formData.get('bulk_expr').includes('PDAC_counts.tsv') && !(formData.get('bulk_meta').includes('PDAC_meta.tsv')) && (formData.get('bulk_meta') != '')) {
                throw new Error("If using example files, please ensure all files are from the same example.")
        }
        if ((formData.get('condition_col') != '') && (formData.get('ctrl_condition') == '') || (formData.get('condition_col') == '') && (formData.get('ctrl_condition') != '')) {
            throw new Error("Please specify both the metadata column corresponding to the control group and the control condition name.")
        }
    }
    }

    async function doSubmit(formData) {
        await validate(formData)
        const res = await fetch(window.location.href, {
            method: 'POST',
            headers: {
                'Accept': 'application/json',
            },
            body: formData,
        })
        if (res.status === 406) {
            let { error } = await res.json()
            throw new Error(error.message)
        } else {
            const { _id } = await res.json()
            window.location.href = `${_id}/`
        }
    }

    function onSubmit(e) {
      e.preventDefault()
      const formData = new FormData(e.target)
      doSubmit(formData).catch(function (e) {
        console.error(e)
        document.getElementById('submit-feedback').innerText = e.toString()
        document.getElementById('submit-feedback').style.visibility = 'visible';
        document.getElementById('submit-feedback').style.opacity = 1;
        //setTimeout(() => {
        //    document.getElementById('submit-feedback').style.opacity = 0;
        //}, 5000)
      })
    }

    function getNumRuns() {
        fetch('/blueprint/numruns').then(response => response.json()).then(data => {
            document.getElementById('numruns').innerText = data.num_runs;
        })
    }
    getNumRuns()
</script>
{% endblock %}